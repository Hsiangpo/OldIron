DNB_CDP_URL=http://127.0.0.1:9222
CNPJBIZ_CDP_URL=http://127.0.0.1:9222
CNPJBIZ_BROWSER_DEBUG_PORT=9226
CNPJBIZ_BROWSER_PROFILE_DIR=/Users/yourname/tmp/cnpjbiz-chrome
CNPJBIZ_BROWSER_PROXY_URL=http://127.0.0.1:7893
CNPJBIZ_BROWSER_SEED_URL=https://cnpj.biz/empresas/estado/SP
CNPJBIZ_BROWSER_LAUNCH_ENABLE=0
CNPJBIZ_BROWSER_FETCH_ENABLE=0
CNPJBIZ_CDP_TIMEOUT_SECONDS=10
CNPJBIZ_COOKIE_CACHE_SECONDS=300
CNPJBIZ_PROXY_URL=
CNPJBIZ_SEED_MODE=homepage
CNPJBIZ_PROXY_FEED_URL=
CNPJBIZ_PROXY_FEED_SCHEME=http
CNPJBIZ_BLURPATH_CDP_URL=http://127.0.0.1:9222
CNPJBIZ_BLURPATH_ENABLE=0
CNPJBIZ_CLASH_UNIX_SOCKET_PATH=/tmp/verge/verge-mihomo.sock
CNPJBIZ_CLASH_SELECTOR_NAME=PROXY
CNPJBIZ_CLASH_ROTATE_ENABLE=0
LLM_API_KEY=
# 注意：以下四项不要照抄历史示例，必须按当前批准的 provider 填写
LLM_BASE_URL=
LLM_MODEL=
LLM_REASONING_EFFORT=
LLM_API_STYLE=auto
LLM_TIMEOUT_SECONDS=120
