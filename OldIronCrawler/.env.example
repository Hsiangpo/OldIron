# 这两项默认关闭：免费稳定的官网邮箱/电话提取不依赖它们。
# 需要时在启动菜单「系统配置」里手动开启，或在此改为 true 持久开启。
SEARCH_REPRESENTATIVE_ENABLED=false
EXTRACT_REPRESENTATIVE_ENABLED=false
# 搜索后端：bing（默认，免 key）或 tavily（需 TAVILY_API_KEY）
SEARCH_BACKEND=bing
SEARCH_REPRESENTATIVE_CONCURRENCY=8
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT_SECONDS=20
PROTOCOL_REQUEST_SLOTS=64
REQUEST_TIMEOUT_SECONDS=10
TOTAL_WAIT_SECONDS=180
