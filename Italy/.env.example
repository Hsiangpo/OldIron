# Italy Wiza 默认走协议采集，外网默认通过 7897 代理
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897

# Wiza 登录态
WIZA_COOKIE_HEADER=
WIZA_USER_AGENT=
